# Modèle d'unité : install-service.sh remplace @DIR@ (dossier où se trouve l'exécutable)
# et @USER@ (propriétaire de ce dossier) puis l'installe dans /etc/systemd/system.
[Unit]
Description=rpi-monitor : surveillance du Raspberry Pi (collecte, API et interface Web)
After=network.target

[Service]
Type=simple
# Tout vit dans le dossier de l'exécutable : le binaire, le fichier « password » et la sauvegarde « history.json ».
ExecStart=@DIR@/rpi-monitor serve
WorkingDirectory=@DIR@
# Port et adresse : surchargeables sans toucher au code (systemctl edit rpi-monitor).
# Par défaut le service n'écoute que sur 127.0.0.1 ; un tunnel le publie.
Environment=RPI_MONITOR_PORT=8765
Environment=RPI_MONITOR_HOST=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=15

# Durcissement : système en lecture seule, seul le dossier de l'exécutable est inscriptible.
User=@USER@
SupplementaryGroups=video
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@DIR@
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
