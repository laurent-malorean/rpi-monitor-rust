[Unit]
Description=rpi-monitor : surveillance du Raspberry Pi (collecte, API et interface Web)
After=network.target

[Service]
Type=simple
# Tout vit dans /opt/rpi-monitor : le binaire, le fichier « password » et la sauvegarde « history.json ».
ExecStart=/opt/rpi-monitor/rpi-monitor serve
WorkingDirectory=/opt/rpi-monitor
# Port et adresse : surchargeables sans toucher au code (systemctl edit rpi-monitor).
# Par défaut le service n'écoute que sur 127.0.0.1 ; un tunnel le publie.
Environment=RPI_MONITOR_PORT=8765
Environment=RPI_MONITOR_HOST=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=15

# Durcissement : système en lecture seule, seul le dossier ci-dessus est inscriptible.
User=rpi-monitor
SupplementaryGroups=video
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/rpi-monitor
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
